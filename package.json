{
  "name": "hosty-speech",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "start": "node dist/server.js",
    "dev": "tsx watch server.ts",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "test:ui": "vitest run test/settings-ui.test.tsx",
    "docs:check": "node scripts/docs-index.mjs --check",
    "check:native": "node --import tsx scripts/check-native.ts"
  },
  "dependencies": {
    "@hosty-sdk/app": "0.32.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "esbuild": "0.25.12",
    "lucide-react": "1.55.0",
    "radix-ui": "1.8.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "transcribe-cpp": "0.4.1",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/react": "16.3.0",
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "jsdom": "27.1.0",
    "playwright": "1.56.1",
    "postcss": "8.5.29",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vitest": "4.0.8"
  }
}
