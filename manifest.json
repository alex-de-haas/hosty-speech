{
  "schemaVersion": "app.0.1",
  "id": "hosty.speech",
  "name": "Hosty Speech",
  "description": "Local multi-model speech-to-text provider with automatic hardware acceleration.",
  "version": "0.1.0",
  "runtimeProfiles": [
    {
      "key": "local",
      "type": "localCommand",
      "default": true
    },
    {
      "key": "dev",
      "type": "localCommand",
      "development": true
    }
  ],
  "defaultRuntime": "local",
  "services": [
    {
      "key": "web",
      "runtimes": {
        "local": {
          "type": "localCommand",
          "workingDirectory": ".",
          "setup": "npm ci --include=dev --no-audit --no-fund && npm run build",
          "command": "node dist/server.js",
          "ports": [
            {
              "key": "http",
              "containerPort": 3520,
              "protocol": "http",
              "public": true
            }
          ],
          "healthcheck": {
            "type": "http",
            "port": 3520,
            "path": "/healthz",
            "timeoutSeconds": 5
          }
        },
        "dev": {
          "type": "localCommand",
          "workingDirectory": ".",
          "setup": "npm ci --include=dev --no-audit --no-fund && npm run build",
          "command": "node dist/server.js",
          "ports": [
            {
              "key": "http",
              "containerPort": 3520,
              "protocol": "http",
              "public": true
            }
          ],
          "healthcheck": {
            "type": "http",
            "port": 3520,
            "path": "/healthz",
            "timeoutSeconds": 5
          }
        }
      }
    }
  ],
  "endpoints": [
    {
      "key": "http",
      "service": "web",
      "port": "http",
      "protocol": "http",
      "public": true
    }
  ],
  "ui": {
    "entrypoint": {
      "endpoint": "http",
      "path": "/settings"
    },
    "settings": {
      "endpoint": "http",
      "path": "/settings"
    }
  },
  "data": {
    "enabled": true,
    "targets": [
      {
        "runtime": "local",
        "environment": "HOSTY_APP_DATA_DIR"
      },
      {
        "runtime": "dev",
        "environment": "HOSTY_APP_DATA_DIR"
      }
    ]
  },
  "cache": {
    "enabled": true,
    "targets": [
      {
        "runtime": "local",
        "environment": "HOSTY_APP_CACHE_DIR"
      },
      {
        "runtime": "dev",
        "environment": "HOSTY_APP_CACHE_DIR"
      }
    ]
  },
  "provides": [
    "speech-to-text"
  ],
  "interfaces": {
    "speech-to-text": [
      {
        "key": "default",
        "endpoint": "http",
        "path": "/api/speech/v1",
        "version": 1,
        "capabilities": [
          "recording"
        ]
      }
    ]
  },
  "capabilities": [
    "logs"
  ],
  "catalogMetadata": {
    "icon": "assets/icon.svg"
  },
  "settings": [
    {
      "key": "HOSTY_SPEECH_NATIVE_LIBRARY",
      "type": "string",
      "default": "",
      "required": false,
      "label": "Advanced native runtime override",
      "description": "Optional absolute path to a trusted matching transcribe.cpp 0.4.1 shared library, such as an installed CUDA bundle. Leave empty for the bundled runtime. Restart to apply."
    },
    {
      "key": "HOSTY_SPEECH_CUDA_RUNTIME_DIR",
      "type": "string",
      "default": "",
      "required": false,
      "label": "Advanced CUDA runtime directory",
      "description": "Optional directory for the matching CUDA runtime libraries required by a native CUDA bundle. Leave empty for normal driver/runtime discovery. Restart to apply."
    }
  ]
}
